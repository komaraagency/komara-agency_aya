# Railway Variables — ne jamais commit de vraies valeurs
TELEGRAM_TOKEN=colle_ici_le_token_du_bot_botfather
AYA_ADMIN_ID=identifiant_telegram_numerique_de_l_admin

# Alias acceptés aussi par le code :
# telegram_token=...
# admin_id=...

# Facultatif : modèle local Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# Persistance et Google Sheets / Calendar (compte de service partagé sur les ressources)
# AYA_DATA_DIR=/data/aya
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEET_ID=identifiant_du_tableur
# GOOGLE_SHEET_RANGE=Leads!A:J
# GOOGLE_CALENDAR_ID=agenda@komara.agency

# Paiements : seuls des liens/pages hébergés par les prestataires sont utilisés
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_SUCCESS_URL=https://komara.agency/paiement/succes
# STRIPE_CANCEL_URL=https://komara.agency/paiement/annule
# PAYPAL_ACCESS_TOKEN=...
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_RETURN_URL=https://komara.agency/paiement/succes
# PAYPAL_CANCEL_URL=https://komara.agency/paiement/annule
# ORANGE_MONEY_CHECKOUT_URL=https://api.orange.com/...
# ORANGE_MONEY_ACCESS_TOKEN=...
# ORANGE_MONEY_RETURN_URL=https://komara.agency/paiement/succes
